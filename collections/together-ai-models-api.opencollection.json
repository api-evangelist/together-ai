          "docs": "Lists all of Together's open-source models"
        },
        {
          "info": {
            "name": "Upload a custom model or adapter",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.together.xyz/v1/models",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upload a custom model or adapter from Hugging Face or S3"
        }
      ]
    }
  ],
  "bundled": true
}