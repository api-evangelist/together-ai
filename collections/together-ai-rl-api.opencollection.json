              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "after",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Lists all training sessions."
        },
        {
          "info": {
            "name": "Create training session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.together.xyz/v1/rl/training-sessions",
            "body": {
              "type": "json",
              "data": "{}"
            }
