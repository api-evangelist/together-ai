                "name": "session_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Stops a training session."
        },
        {
          "info": {
            "name": "Get forward-backward operation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.together.xyz/v1/rl/training-sessions/:session_id/operations/forward-backward/:operation_id",
