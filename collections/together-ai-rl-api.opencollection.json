{
  "opencollection": "1.0.0",
  "info": {
    "name": "remediation.proto Audio RL API",
    "version": "version not set"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "RL",
        "type": "folder"
      },
      "items": [
