            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"language\": \"python\",\n  \"code\": \"<string>\",\n  \"files\": [\n    {\n      \"name\": \"<string>\",\n      \"encoding\": \"<string>\",\n      \"content\": \"<string>\"\n    },\n    {\n      \"name\": \"<string>\",\n      \"encoding\": \"<string>\",\n      \"content\": \"<string>\"\n    }\n  ],\n  \"session_id\": \"<string>\"\n}",
