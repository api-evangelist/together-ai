          "name": "Cancel a queued job",
          "request": {
            "name": "Cancel a queued job",
            "description": {
              "content": "Cancel a pending job. Only jobs in pending status can be canceled.\nRunning jobs cannot be stopped. Returns the job status after the\nattempt. If the job is not pending, returns 409 with the current status\nunchanged.\n",
